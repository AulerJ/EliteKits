# URL do site (para compartilhamento e PWA - use a URL pública, ex: https://seusite.com)
NEXT_PUBLIC_SITE_URL=https://seusite.com

# Nome exibido no header, metadata e PWA (opcional; padrão EliteKits neste repo).
# NEXT_PUBLIC_SITE_NAME=EliteKits

# Vitrine secundária EliteKits: obrigatório neste deploy — catálogo filtra por product_store_listings.
# Na loja principal: não defina ou deixe vazio.
# NEXT_PUBLIC_STORE_SLUG=elite_kits

# Logo (opcional - padrão /logo.png)
# NEXT_PUBLIC_LOGO_URL=https://seusite.com/logo.png

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://vttcutayabvbdcbuykxl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ0dGN1dGF5YWJ2YmRjYnV5a3hsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzEzNzgxMTQsImV4cCI6MjA4Njk1NDExNH0.s70DuJsn_Cc8zjj8dgSU1mUfjNMrMroUHeij4cmSEW0
# Service role (obrigatório para admin): capa do site, avaliações da home, config home. Supabase Dashboard > Settings > API > service_role
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# WhatsApp (para botão de contato)
NEXT_PUBLIC_WHATSAPP_NUMBER=+12033947243

# Instagram oficial via Meta Graph API
# Requer conta profissional/comercial do Instagram conectada ao ecossistema Meta.
# Docs: https://developers.facebook.com/docs/instagram-platform/reference/instagram-media/
NEXT_PUBLIC_INSTAGRAM_USERNAME=favela_store_usa
# Ex.: 1784...
INSTAGRAM_IG_USER_ID=
# Token de longa duração com permissão para ler a mídia da conta
INSTAGRAM_GRAPH_ACCESS_TOKEN=
# Opcional: troque a versão se precisar
# INSTAGRAM_GRAPH_API_VERSION=v23.0

# Cloudinary (storage de imagens - 25GB free)
# Crie conta em cloudinary.com e pegue em Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Stripe – notificação por email quando alguém compra (webhook)
# Crie API key em resend.com e defina o email que recebe os avisos de novo pedido
# STORE_OWNER_EMAIL=duducury1998@gmail.com
# RESEND_API_KEY=re_xxxx
# Remetente dos emails (use um @seu-dominio.com após verificar o domínio no Resend)
# RESEND_FROM_EMAIL=Favela Store <noreply@favelastore.com>
# Teste de email: defina EMAIL_TEST_SECRET e acesse /api/test-email?secret=valor
# EMAIL_TEST_SECRET=teste123

# eBay – manter listagens em sync com o site (veja docs/EBAY_SYNC.md e docs/EBAY_SETUP.md)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# RuName do eBay (obrigatório): Application Keys → User Tokens → valor RuName. NÃO use URL aqui.
# EBAY_RUNAME=Eduardo_Cury-Eduardo_Cury-PRD-xxxxx
# (alternativa antiga: EBAY_REDIRECT_URI, mas o eBay exige RuName no token exchange)
# EBAY_REFRESH_TOKEN=
# EBAY_ENV=sandbox
# EBAY_MERCHANT_LOCATION_KEY=default
# Opcionais: para criar o local automaticamente se não existir (evita erro 25002)
# EBAY_LOCATION_NAME=Default Location
# EBAY_LOCATION_COUNTRY=US
# EBAY_LOCATION_POSTAL_CODE=06606
# EBAY_LOCATION_STATE=CT
# EBAY_LOCATION_CITY=Bridgeport
# EBAY_LOCATION_ADDRESS_LINE1=582 Gurdon St
# EBAY_CATEGORY_ID=11450
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_FULFILLMENT_POLICY_ID=
